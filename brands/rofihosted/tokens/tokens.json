{
  "$description": "rofihosted design tokens. Source of truth: apps/web/public/cc.css (:root). Values copied verbatim; if they ever differ, cc.css wins and this file must be regenerated.",
  "color": {
    "surface": {
      "bg":        { "value": "#0a0b0d", "role": "App canvas, deepest layer, recessed wells" },
      "surface-1": { "value": "#121316", "role": "Sidebar, dialogs, input wells, file cards" },
      "surface-2": { "value": "#181a1e", "role": "Cards (cc-card), menus, hover rows" },
      "surface-3": { "value": "#202329", "role": "Raised chips, active rows, user bubbles, secondary buttons" },
      "edge-light": { "value": "rgba(255,255,255,0.06)", "role": "Top highlight, popover border" },
      "border":     { "value": "rgba(255,255,255,0.08)", "role": "All 1px outlines and dividers" }
    },
    "brand": {
      "lime-1":  { "value": "#bef264", "role": "Brand text/links/active icons (lime-300)" },
      "lime-2":  { "value": "#a3e635", "role": "Brand fills, focus rings, send button, logo base (lime-400)" },
      "lime-hi": { "value": "#c8f56e", "role": "Top of the logo and primary-button gradient" },
      "ink":     { "value": "#14310a", "role": "Dark green text/glyph on lime (never pure black)" }
    },
    "text": {
      "tx-1": { "value": "#f7f8f8", "role": "Primary text" },
      "tx-2": { "value": "#a0a4ad", "role": "Secondary text, nav" },
      "tx-3": { "value": "#686d77", "role": "Tertiary, placeholders, meta (large/UI text only)" }
    },
    "semantic": {
      "ok":   { "value": "#4ade80", "role": "Online, success" },
      "warn": { "value": "#fbbf24", "role": "Degraded, warnings in logs" },
      "bad":  { "value": "#fb7185", "role": "Error, destructive (a rose, not a red)" },
      "info": { "value": "#60a5fa", "role": "Informational" }
    }
  },
  "gradient": {
    "primary-button": "linear-gradient(180deg, #c8f56e, #a3e635)",
    "logo-tile": "linear-gradient(180deg, #c8f56e, #a3e635)",
    "surface-sheen": "linear-gradient(180deg, rgba(255,255,255,0.035), rgba(255,255,255,0) 38%)",
    "ambient-glow": "radial-gradient(circle, rgba(163,230,53,0.18), transparent 70%) + blur(40px)"
  },
  "elevation": {
    "e1": "inset 0 1px 0 rgba(255,255,255,0.05), 0 1px 2px rgba(0,0,0,0.45)",
    "e2": "inset 0 1px 0 rgba(255,255,255,0.06), 0 4px 14px rgba(0,0,0,0.40)",
    "e3": "inset 0 1px 0 rgba(255,255,255,0.07), 0 14px 36px rgba(0,0,0,0.50)",
    "well": "inset 0 2px 5px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.03)",
    "glow-brand": "0 0 24px rgba(163,230,53,0.18)",
    "button-primary": "inset 0 1px 0 rgba(255,255,255,0.45), 0 6px 18px rgba(163,230,53,0.22)",
    "dialog": "0 30px 80px rgba(0,0,0,0.55)"
  },
  "radius": { "sm": "12px", "base": "16px", "lg": "20px", "xl": "24px", "pill": "999px", "logo": "25%", "bubble": "18px 18px 6px 18px", "composer": "22px" },
  "font": {
    "display": { "family": "Space Grotesk Variable", "weights": "300-700", "role": "Brand, headlines, wordmark", "file": "assets/fonts/space-grotesk-latin-wght-normal.woff2" },
    "sans":    { "family": "Inter Variable", "weights": "100-900", "role": "Interface and the user's own words", "file": "assets/fonts/inter-latin-wght-normal.woff2" },
    "serif":   { "family": "Fraunces Variable", "weights": "100-900", "axes": "SOFT 60-100, WONK 0, opsz auto", "role": "The assistant's voice, greetings, status headings", "file": "assets/fonts/fraunces-latin-full-normal.woff2" },
    "mono":    { "family": "JetBrains Mono Variable", "weights": "100-800", "role": "Code, logs, eyebrows, step tags, kbd, numbers", "file": "assets/fonts/jetbrains-mono-latin-wght-normal.woff2" }
  },
  "motion": {
    "ease": "cubic-bezier(0.22, 1, 0.36, 1)",
    "ease-spring": "cubic-bezier(0.34, 1.4, 0.5, 1)",
    "dur-1": "150ms",
    "dur-2": "240ms",
    "dur-3": "380ms",
    "stagger-step": "45ms",
    "rise-distance": "12px",
    "shimmer": "1.8s linear infinite",
    "pulse": "1.4s ease-in-out infinite",
    "spin": "0.9s linear infinite"
  },
  "layout": {
    "sidebar-width": "280px",
    "thread-column": { "default": "780px", "medium": "940px", "wide": "1140px" },
    "home-column": "680px",
    "settings-dialog": "1020 x 780, nav 216px",
    "breakpoint-mobile": "860px",
    "icon-grid": "24px viewBox, stroke 1.8, round caps and joins, 18px rendered in nav"
  },
  "logo": {
    "viewBox": "0 0 64 64",
    "tile": { "rx": 16, "gradient": ["#c8f56e", "#a3e635"] },
    "frame": { "x": 16, "y": 16, "size": 32, "rx": 10, "stroke": 7, "color": "#14310a" },
    "notch": { "cx": 46, "cy": 18, "r": 9.5 },
    "dot": { "cx": 46, "cy": 18, "r": 5 }
  },
  "punchlines": {
    "hero": "One tablet. A real server.",
    "sub": "A personal server and AI assistant running entirely on a single tablet.",
    "slogans": [
      "Billion-dollar intelligence. Zero-dollar cloud rent.",
      "Your thoughts belong on your desk, not someone else's balance sheet.",
      "It doesn't just chat. It does the work.",
      "An assistant that actually remembers who you are.",
      "Small screen. Immense sovereignty.",
      "Dari meja kos, menembus dunia.",
      "Decoupled from Big Tech landlords. Anchored in local silicon.",
      "Don't rent the future. Host it."
    ],
    "jargon": {
      "sovereignty": "Compute sovereignty is not a luxury feature. It is a baseline human right.",
      "antiLandlord": "Decoupled from Big Tech landlords. Anchored in local silicon.",
      "privacy": "Zero telemetry by architecture, not by corporate policy.",
      "continuity": "Your memory should outlive any platform's terms of service."
    },
    "keynoteClimax": "Don't rent the future. Host it."
  }
}
